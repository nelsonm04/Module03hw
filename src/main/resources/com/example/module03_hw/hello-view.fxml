<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="317.0" prefWidth="409.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.module03_hw.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Interest Rate (%):" />
    <TextField fx:id="IntRate" />

    <Label text="Number of Years:" />
    <TextField fx:id="NumYears" />

    <Label text="Loan Amount:" />
    <TextField fx:id="LoanAmount" />

    <Button onAction="#onHelloButtonClick" text="Calculate" />

    <Label text="Monthly Payment:" />
    <TextField fx:id="MonthlyPayment" editable="false" />

    <Label text="Total Payment:" />
    <TextField fx:id="TotalPayment" editable="false" />
    <Label fx:id="welcomeText" text="Enter values and click Calculate" />

</VBox>
